# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o .env para o GitHub.

PORT=3000

# ---- Credenciais ZuckPay ----
# Painel ZuckPay > Integracoes / API > Client ID e Client Secret.
# Autenticacao: Basic base64(client_id:client_secret).
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# Webhook Secret (Credenciais API > gerar). NAO e o mesmo que o Client Secret.
# Sem ele o postback chega sem assinatura e o servidor aceita sem validar.
ZUCKPAY_WEBHOOK_SECRET=

# ---- Endpoints ZuckPay (conferidos na doc oficial v3) ----
# Sempre com "www": sem ele o CDN converte o POST em GET e devolve 405.
ZUCKPAY_BASE_URL=https://www.zuckpay.com.br/conta
ZUCKPAY_PIX_PATH=/v3/pix/qrcode
ZUCKPAY_STATUS_PATH=/v3/pix/status
ZUCKPAY_CARD_PATH=/v3/card/charge

# URL publica do site, usada como callbackUrl das transacoes.
# Em producao: https://casadasofertas.vercel.app
PUBLIC_URL=

# ---- Meta (API de Conversoes) ----
# Gerenciador de Eventos > seu conjunto de dados > Configuracoes >
# "Gerar token de acesso". O ID do pixel e o mesmo que esta em js/tracking.js.
META_PIXEL_ID=1780777813273982
META_CAPI_TOKEN=

# ---- Utmify (API de Pedidos, server-side) ----
# Painel da Utmify > Integracoes > API de Credenciais > gerar token.
# Registra cada venda (pendente e paga) mesmo com o navegador fechado.
UTMIFY_API_TOKEN=

# ---- Produto ----
PRODUCT_PRICE=109.90
# Frete fixo, cobrado para qualquer CEP e somado ao total do Pix.
# Se mudar aqui, ajuste tambem FRETE em public/js/checkout.js, o valor exibido
# em public/checkout.html e o texto de public/politica-frete.html.
SHIPPING_PRICE=19.90
